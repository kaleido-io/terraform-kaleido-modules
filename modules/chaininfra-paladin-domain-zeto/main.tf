locals {
  deploy        = var.mode == "deploy"
  create_builds = var.mode != "join"

  # Either the signing_key_uri or signing_key_address of the intended signer
  # URI and address are interchangeable
  signing_identity = local.deploy ? coalesce(var.signing_key_uri, var.signing_key_address) : null

  paladin_base_url = "${trimsuffix(var.paladin_repo, "/")}/blob/${var.paladin_ref}"

  sources = {
    zeto_factory = {
      contract_url  = "${local.paladin_base_url}/solidity/contracts/domains/zeto/ZetoFactory.sol"
      contract_name = "ZetoFactory"
    }
    zeto_factory_proxy = {
      contract_url  = "https://github.com/OpenZeppelin/openzeppelin-contracts/blob/v5.1.0/contracts/proxy/ERC1967/ERC1967Proxy.sol"
      contract_name = "ERC1967Proxy"
    }
  }

  # Groth16 verifier contract for each circuit. The verifiers embed the circuit's
  # verification key, so they must come from the same trusted setup as the proving keys
  # the nodes use.
  circuit_verifiers = {
    anon                                = "Groth16Verifier_Anon"
    anon_batch                          = "Groth16Verifier_AnonBatch"
    deposit                             = "Groth16Verifier_Deposit"
    withdraw                            = "Groth16Verifier_Withdraw"
    withdraw_batch                      = "Groth16Verifier_WithdrawBatch"
    anon_nullifier_transfer             = "Groth16Verifier_AnonNullifierTransfer"
    anon_nullifier_transfer_batch       = "Groth16Verifier_AnonNullifierTransferBatch"
    anon_nullifier_transferLocked       = "Groth16Verifier_AnonNullifierTransferLocked"
    anon_nullifier_transferLocked_batch = "Groth16Verifier_AnonNullifierTransferLockedBatch"
    withdraw_nullifier                  = "Groth16Verifier_WithdrawNullifier"
    withdraw_nullifier_batch            = "Groth16Verifier_WithdrawNullifierBatch"
  }

  # Token implementations the module can register with the factory:
  # - libraries: libraries the implementation links
  # - verifiers: the circuit whose verifier fills each factory verifier slot; slots not
  #   listed (e.g. lock/burn for Zeto_Anon) are registered as the zero address
  # - circuits: the domain config circuits the nodes prove each operation with (the
  #   domain adds the _batch suffix for transactions with more than 2 inputs or outputs)
  implementation_catalog = {
    Zeto_Anon = {
      build_name = "zeto_anon"
      libraries  = []
      verifiers = {
        verifier              = "anon"
        batchVerifier         = "anon_batch"
        depositVerifier       = "deposit"
        withdrawVerifier      = "withdraw"
        batchWithdrawVerifier = "withdraw_batch"
      }
      circuits = {
        deposit        = { name = "deposit" }
        withdraw       = { name = "withdraw" }
        transfer       = { name = "anon" }
        transferLocked = { name = "anon" }
      }
    }
    Zeto_AnonNullifier = {
      build_name = "zeto_anon_nullifier"
      libraries  = ["PoseidonUnit2L", "PoseidonUnit3L", "SmtLib"]
      verifiers = {
        verifier              = "anon_nullifier_transfer"
        batchVerifier         = "anon_nullifier_transfer_batch"
        depositVerifier       = "deposit"
        withdrawVerifier      = "withdraw_nullifier"
        batchWithdrawVerifier = "withdraw_nullifier_batch"
        lockVerifier          = "anon_nullifier_transferLocked"
        batchLockVerifier     = "anon_nullifier_transferLocked_batch"
      }
      circuits = {
        deposit        = { name = "deposit" }
        withdraw       = { name = "withdraw_nullifier", usesNullifiers = true }
        transfer       = { name = "anon_nullifier_transfer", usesNullifiers = true }
        transferLocked = { name = "anon_nullifier_transferLocked", usesNullifiers = true }
      }
    }
  }

  verifier_slots = [
    "verifier", "depositVerifier", "withdrawVerifier", "lockVerifier", "burnVerifier",
    "batchVerifier", "batchWithdrawVerifier", "batchLockVerifier", "batchBurnVerifier",
  ]

  implementations = { for name in var.implementations : name => local.implementation_catalog[name] }
  circuits        = toset(flatten([for impl in local.implementations : values(impl.verifiers)]))
  libraries       = toset(flatten([for impl in local.implementations : impl.libraries]))

  # Implementations that link libraries are read from the archive once the libraries are
  # deployed, with their addresses linked into the bytecode
  linked_implementations   = [for name, impl in local.implementations : name if length(impl.libraries) > 0]
  unlinked_implementations = [for name, impl in local.implementations : name if length(impl.libraries) == 0]

  # The Poseidon hash libraries are generated bytecode (circomlibjs poseidonContract) rather
  # than compiled Solidity, so the release archive only has empty stubs for them. These are
  # the generated contracts, identical for every Zeto release.
  generated_libraries = {
    for lib, file in { PoseidonUnit2L = "Poseidon2.json", PoseidonUnit3L = "Poseidon3.json" } :
    lib => jsondecode(file("${path.module}/poseidon/${file}"))
  }
  archive_libraries = [for lib in local.libraries : lib if !contains(keys(local.generated_libraries), lib)]

  zero_address = "0x0000000000000000000000000000000000000000"
}

# Compiled token, verifier and library contracts, read from the Zeto contracts archive
data "kaleido_platform_contract_archive" "zeto" {
  count = local.create_builds ? 1 : 0

  url = var.contracts_archive_url
  contracts = concat(
    local.unlinked_implementations,
    [for circuit in local.circuits : local.circuit_verifiers[circuit]],
    local.archive_libraries,
  )
}

# Implementations that link libraries, with the deployed library addresses linked in. The
# builds in join_with_builds mode are for ABI visibility only, so link the zero address.
data "kaleido_platform_contract_archive" "zeto_linked" {
  count = local.create_builds && length(local.linked_implementations) > 0 ? 1 : 0

  url       = var.contracts_archive_url
  contracts = local.linked_implementations
  libraries = {
    for lib in local.libraries : lib => local.deploy ? kaleido_platform_evm_connector_contract_deploy.library[lib].contract_address : local.zero_address
  }
}

# Verification keys from a local proving keys archive, used to check the verifier contracts
# match the proving keys before deploying them. Skipped for remote archives, to avoid
# downloading the full proving keys archive on every plan.
data "kaleido_platform_contract_archive" "verification_keys" {
  count = local.deploy && startswith(var.proving_keys_archive_url, "file:") ? 1 : 0

  url       = var.proving_keys_archive_url
  contracts = []
  files     = [for circuit in local.circuits : "${circuit}-vkey.json"]
}

locals {
  # ABIs are normalized with jsonencode(jsondecode()) in the builds below, so that only a
  # change to the ABI itself, not its formatting in the archive, replaces a build.
  # Linked implementations are picked individually, so that the others stay known while
  # the libraries they wait on are deployed.
  artifacts = try(data.kaleido_platform_contract_archive.zeto[0].artifacts, {})
  implementation_artifacts = {
    for name in keys(local.implementations) : name => contains(local.linked_implementations, name) ? data.kaleido_platform_contract_archive.zeto_linked[0].artifacts[name] : local.artifacts[name]
  }
  library_artifacts = {
    for lib in local.libraries : lib => contains(keys(local.generated_libraries), lib) ? {
      abi      = jsonencode(local.generated_libraries[lib].abi)
      bytecode = local.generated_libraries[lib].bytecode
    } : local.artifacts[lib]
  }

  # A Groth16 verifier embeds each verification key constant as a 32-byte word. Coordinates
  # of 0 and 1 (the projective z coordinate) are skipped as they match any bytecode.
  verifier_mismatches = {
    for circuit in local.circuits : circuit => [
      for n in flatten([for k, v in jsondecode(data.kaleido_platform_contract_archive.verification_keys[0].file_contents["${circuit}-vkey.json"]) : v if contains(["vk_alpha_1", "vk_beta_2", "vk_gamma_2", "vk_delta_2", "IC"], k)]) : n
      if !contains(["0", "1"], n) && !strcontains(lower(local.artifacts[local.circuit_verifiers[circuit]].bytecode), format("%064x", tonumber(n)))
    ] if length(data.kaleido_platform_contract_archive.verification_keys) > 0
  }
}

# ContractManager builds
resource "kaleido_platform_cms_build" "zeto_factory" {
  count = local.create_builds ? 1 : 0

  environment  = var.environment_id
  service      = var.contracts_service_id
  type         = "github"
  name         = "${var.resource_prefix}zeto_factory"
  path         = var.build_path
  solc_version = "v0.8.36+commit.8a079791"
  evm_version  = "shanghai"
  optimizer    = var.contract_optimizer

  github = {
    contract_url  = local.sources.zeto_factory.contract_url
    contract_name = local.sources.zeto_factory.contract_name
  }
}

resource "kaleido_platform_cms_build" "zeto_factory_proxy" {
  count = local.create_builds ? 1 : 0

  environment  = var.environment_id
  service      = var.contracts_service_id
  type         = "github"
  name         = "${var.resource_prefix}zeto_factory_proxy"
  path         = var.build_path
  solc_version = "v0.8.36+commit.8a079791"
  evm_version  = "shanghai"
  optimizer    = var.contract_optimizer

  github = {
    contract_url  = local.sources.zeto_factory_proxy.contract_url
    contract_name = local.sources.zeto_factory_proxy.contract_name
  }

  depends_on = [kaleido_platform_cms_build.zeto_factory]
}

resource "kaleido_platform_cms_build" "verifier" {
  for_each = local.create_builds ? local.circuits : toset([])

  environment = var.environment_id
  service     = var.contracts_service_id
  type        = "precompiled"
  name        = "${var.resource_prefix}zeto_verifier_${each.key}"
  path        = var.build_path

  precompiled = {
    abi      = jsonencode(jsondecode(local.artifacts[local.circuit_verifiers[each.key]].abi))
    bytecode = local.artifacts[local.circuit_verifiers[each.key]].bytecode
  }

  depends_on = [kaleido_platform_cms_build.zeto_factory_proxy]
}

resource "kaleido_platform_cms_build" "library" {
  for_each = local.create_builds ? local.libraries : toset([])

  environment = var.environment_id
  service     = var.contracts_service_id
  type        = "precompiled"
  name        = "${var.resource_prefix}zeto_${each.key}"
  path        = var.build_path

  precompiled = {
    abi      = jsonencode(jsondecode(local.library_artifacts[each.key].abi))
    bytecode = local.library_artifacts[each.key].bytecode
  }

  depends_on = [kaleido_platform_cms_build.zeto_factory_proxy]
}

resource "kaleido_platform_cms_build" "implementation" {
  for_each = local.create_builds ? local.implementations : {}

  environment = var.environment_id
  service     = var.contracts_service_id
  type        = "precompiled"
  name        = "${var.resource_prefix}${each.value.build_name}"
  path        = var.build_path

  precompiled = {
    abi      = jsonencode(jsondecode(local.implementation_artifacts[each.key].abi))
    bytecode = local.implementation_artifacts[each.key].bytecode
  }

  depends_on = [kaleido_platform_cms_build.zeto_factory_proxy]
}

# EVM connector deploys (idempotent - identity is a key derived from the inputs)
resource "kaleido_platform_evm_connector_contract_deploy" "verifier" {
  for_each = local.deploy ? local.circuits : toset([])

  environment = var.environment_id
  service     = var.connector_service_id
  api         = var.connector_api_name
  key         = local.signing_identity
  abi         = kaleido_platform_cms_build.verifier[each.key].abi
  bytecode    = kaleido_platform_cms_build.verifier[each.key].bytecode

  lifecycle {
    precondition {
      condition     = length(lookup(local.verifier_mismatches, each.key, [])) == 0
      error_message = "${local.circuit_verifiers[each.key]} in the contracts archive does not match ${each.key}-vkey.json in the proving keys archive, so it would reject the nodes' proofs. Use contracts and proving keys from the same Zeto release or trusted setup."
    }
  }
}

resource "kaleido_platform_evm_connector_contract_deploy" "library" {
  for_each = local.deploy ? local.libraries : toset([])

  environment = var.environment_id
  service     = var.connector_service_id
  api         = var.connector_api_name
  key         = local.signing_identity
  abi         = kaleido_platform_cms_build.library[each.key].abi
  bytecode    = kaleido_platform_cms_build.library[each.key].bytecode
}

resource "kaleido_platform_evm_connector_contract_deploy" "implementation" {
  for_each = local.deploy ? local.implementations : {}

  environment = var.environment_id
  service     = var.connector_service_id
  api         = var.connector_api_name
  key         = local.signing_identity
  abi         = kaleido_platform_cms_build.implementation[each.key].abi
  bytecode    = kaleido_platform_cms_build.implementation[each.key].bytecode
}

resource "kaleido_platform_evm_connector_contract_deploy" "factory_impl" {
  count = local.deploy ? 1 : 0

  environment = var.environment_id
  service     = var.connector_service_id
  api         = var.connector_api_name
  key         = local.signing_identity
  abi         = kaleido_platform_cms_build.zeto_factory[0].abi
  bytecode    = kaleido_platform_cms_build.zeto_factory[0].bytecode
}

resource "kaleido_platform_evm_connector_contract_deploy" "factory_proxy" {
  count = local.deploy ? 1 : 0

  environment = var.environment_id
  service     = var.connector_service_id
  api         = var.connector_api_name
  key         = local.signing_identity
  abi         = kaleido_platform_cms_build.zeto_factory_proxy[0].abi
  bytecode    = kaleido_platform_cms_build.zeto_factory_proxy[0].bytecode

  # ERC1967Proxy constructor args, keyed by input name (the connector's deploy
  # operation requires params as an object): implementation + initializer
  # calldata. ZetoFactory's initializer takes no arguments (default 0x8129fc1c =
  # initialize()); it makes the deployer the factory owner, which is required to
  # register token implementations below.
  params_json = jsonencode({
    implementation = kaleido_platform_evm_connector_contract_deploy.factory_impl[0].contract_address
    _data          = var.factory_initializer_selector
  })
}

locals {
  verifier_addresses = { for circuit, d in kaleido_platform_evm_connector_contract_deploy.verifier : circuit => d.contract_address }
}

# Registers each token implementation and its verifiers with the factory, under the name
# the domain config references. Owner-only, so it is signed by the deployer.
resource "kaleido_platform_evm_connector_contract_invoke" "register" {
  for_each = local.deploy ? local.implementations : {}

  environment = var.environment_id
  service     = var.connector_service_id
  api         = var.connector_api_name
  key         = local.signing_identity
  to          = kaleido_platform_evm_connector_contract_deploy.factory_proxy[0].contract_address
  abi         = kaleido_platform_cms_build.zeto_factory[0].abi
  method      = "registerImplementation"

  params_json = jsonencode({
    name = each.key
    implementation = {
      implementation = kaleido_platform_evm_connector_contract_deploy.implementation[each.key].contract_address
      verifiers = {
        for slot in local.verifier_slots : slot => lookup(local.verifier_addresses, lookup(each.value.verifiers, slot, ""), local.zero_address)
      }
    }
  })
}

locals {
  factory_address = !local.deploy ? var.factory_address : try(
    kaleido_platform_evm_connector_contract_deploy.factory_proxy[0].contract_address, null
  )
}

